# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Logisat
LOGISAT_SERVER=
LOGISAT_USERNAME=
LOGISAT_PASSWORD=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Cron
CRON_SECRET=

# Сервис фактур компании (необязательно). INVOICING_PROVIDER=fakturowo|fakturownia —
# если не задан, берётся тот, у которого заданы ключи.
INVOICING_PROVIDER=
# Fakturowo.pl: Konto → API (услуга платная). В KSeF — кнопкой «Wyślij do KSeF» в Fakturowo.
FAKTUROWO_API_ID=
# Fakturownia: отправляет в KSeF сама. FAKTUROWNIA_DOMAIN — «firma» из firma.fakturownia.pl
FAKTUROWNIA_DOMAIN=
FAKTUROWNIA_API_TOKEN=
