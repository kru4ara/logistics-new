# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Logisat
# GPS-сервис компании: GPS_PROVIDER=logisat (если не задан — тот, у которого заданы ключи).
# Новый сервис — модуль в lib/gps/.
GPS_PROVIDER=
LOGISAT_SERVER=
LOGISAT_USERNAME=
LOGISAT_PASSWORD=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=

# Cron
CRON_SECRET=

# Сервис фактур компании (необязательно). INVOICING_PROVIDER=fakturowo|fakturownia —
# если не задан, берётся тот, у которого заданы ключи.
INVOICING_PROVIDER=
# Fakturowo.pl: Konto → API (услуга платная). В KSeF — кнопкой «Wyślij do KSeF» в Fakturowo.
FAKTUROWO_API_ID=
# Fakturownia: отправляет в KSeF сама. FAKTUROWNIA_DOMAIN — «firma» из firma.fakturownia.pl
FAKTUROWNIA_DOMAIN=
FAKTUROWNIA_API_TOKEN=

# KSeF — входящие фактуры подрядчиков (только чтение). Необязательно.
# Токен: Aplikacja Podatnika KSeF → Tokeny → право «przeglądanie faktur» (InvoiceRead).
KSEF_TOKEN=
KSEF_NIP=
# prod (по умолчанию) | demo | test
KSEF_ENV=

# Почта компании — напоминания клиентам о просрочке (необязательно).
# SMTP ящика компании: 465 — SSL, 587 — STARTTLS. SMTP_FROM — «Название <biuro@firma.pl>».
# Gmail / Google Workspace: smtp.gmail.com, пароль приложения (не основной пароль).
MAIL_PROVIDER=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
